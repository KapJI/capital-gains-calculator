\definecolor{ReportNavy}{RGB}{31, 56, 77}
\definecolor{ReportTeal}{RGB}{0, 116, 122}
\definecolor{ReportMuted}{RGB}{91, 105, 116}
\definecolor{ReportRule}{RGB}{197, 208, 214}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.3em}
\setlength{\emergencystretch}{1em}

\newcommand{\reportpagestyle}{%
    \fancyhf{}%
    \fancyhead[L]{\small\color{ReportNavy}Capital Gains Tax Report}%
    \fancyhead[R]{\small\color{ReportMuted}\VAR{ report.title_period }}%
    \fancyfoot[C]{\small\color{ReportMuted}Page \thepage}%
    \renewcommand{\headrulewidth}{0.4pt}%
    \renewcommand{\footrulewidth}{0pt}%
}
\fancypagestyle{report}{\reportpagestyle}
\fancypagestyle{plain}{\reportpagestyle}
\pagestyle{report}

\newcolumntype{R}{>{\raggedleft\arraybackslash}p{4.2cm}}
\newenvironment{summarytable}
    {\begingroup\renewcommand{\arraystretch}{1.18}\tabularx{\textwidth}{@{}X R@{}}}
    {\endtabularx\endgroup}
\newcommand{\summaryheading}[1]{%
    \par\vspace{0.8em}%
    {\large\bfseries\color{ReportTeal}#1}\par
    \vspace{0.2em}{\color{ReportRule}\hrule}\vspace{0.35em}%
}
\newcommand{\summaryrow}[2]{#1 & #2\\}
\newcommand{\summarynote}[2]{{\small\color{ReportMuted}\quad #1} & {\small\color{ReportMuted}#2}\\}
\newcommand{\summarytotal}[2]{\noalign{\vskip0.25em}{\bfseries\color{ReportNavy}#1} & {\bfseries\color{ReportNavy}#2}\\}
\newcommand{\reportsection}[1]{\section*{\color{ReportNavy}#1}}
\newcommand{\reportdate}[1]{\subsection*{\color{ReportTeal}#1}}
\newcommand{\reportevent}[1]{\subsubsection*{\color{ReportNavy}#1}}
\newcommand{\reportneedspace}[1]{%
    \par\begingroup
    \dimen0=\pagegoal
    \advance\dimen0 by -\pagetotal
    \ifdim\dimen0<#1\relax\newpage\fi
    \endgroup
}
\newenvironment{reportlist}
    {\begin{enumerate}\setlength{\itemsep}{0.4em}\setlength{\topsep}{0.4em}}
    {\end{enumerate}}
\begin{document}
\thispagestyle{report}

\BLOCK{ set total_gain = namespace(value=Decimal(0)) }
\BLOCK{ set total_loss = namespace(value=Decimal(0)) }
\BLOCK{ set gift_loss = namespace(value=Decimal(0)) }
\BLOCK{ set acquisition_count = namespace(value=0) }
\BLOCK{ set disposal_count = namespace(value=0) }
\BLOCK{ set dividend_count = namespace(value=0) }
\BLOCK{ set interest_count = namespace(value=0) }
\BLOCK{ set interest_tax_count = namespace(value=0) }
\BLOCK{ set eri_count = namespace(value=0) }
\BLOCK{ set rule_labels = {
    "SECTION_104": "Section 104",
    "SAME_DAY": "Same-day rule",
    "BED_AND_BREAKFAST": "30-day rule",
    "SPIN_OFF": "Spin-off",
    "DIVIDEND": "Dividend",
    "INTEREST": "Interest",
    "EXCESS_REPORTED_INCOME": "Excess reported income",
    "EXCESS_REPORTED_INCOME_DISTRIBUTION": "Excess reported income distribution"
} }

\vspace*{0.25cm}
{\color{ReportNavy}\Huge\bfseries Capital Gains Tax Report\par}
\vspace{0.15em}
{\color{ReportMuted}\large
\BLOCK{ if report.period_start is not none and report.period_end is not none }
Reporting period \VAR{ report.period_start.strftime("%d %B %Y") } to \VAR{ report.period_end.strftime("%d %B %Y") }%
\BLOCK{ else }
Tax year \VAR{ report.title_period }%
\BLOCK{ endif }
\par}

\reportsection{Tax summary}

\summaryheading{Capital gains}
\begin{summarytable}
\summaryrow{Disposals}{\VAR{ report.disposal_count }}
\summaryrow{Disposal proceeds}{\VAR{ gbp(report.disposal_proceeds) }}
\summaryrow{Allowable costs}{\VAR{ gbp(report.allowable_costs) }}
\summaryrow{Gains}{\VAR{ gbp(report.capital_gain) }}
\summaryrow{Losses}{\VAR{ gbp(-report.capital_loss) }}
\BLOCK{ if report.gift_loss < 0 }
\summaryrow{Losses on gifts (kept separate)}{\VAR{ gbp(-report.gift_loss) }}
\BLOCK{ endif }
\BLOCK{ if report.exempt_disposal_count > 0 }
\summaryrow{Exempt disposals}{\VAR{ report.exempt_disposal_count }}
\summaryrow{Exempt disposal proceeds}{\VAR{ gbp(report.exempt_disposal_proceeds) }}
\BLOCK{ endif }
\summarytotal{Total gain}{\VAR{ gbp(report.total_gain()) }}
\BLOCK{ if report.capital_gain_allowance is not none }
\summaryrow{Annual exempt amount}{\VAR{ gbp(report.capital_gain_allowance) }}
\summarytotal{Taxable gain}{\VAR{ gbp(report.taxable_gain()) }}
\BLOCK{ else }
\summaryrow{Annual exempt amount}{Not available}
\BLOCK{ endif }
\end{summarytable}
{\small\color{ReportMuted}
Amounts are rounded to the nearest penny individually, so a line may differ
from its components by a penny.\par}

\summaryheading{Dividends}
\begin{summarytable}
\summaryrow{Dividend income}{\VAR{ gbp(report.total_dividends_amount()) }}
\BLOCK{ if report.total_eri_amount(is_interest=False) > 0 }
\summarynote{of which excess reported income}{\VAR{ gbp(report.total_eri_amount(is_interest=False)) }}
\BLOCK{ endif }
\BLOCK{ if report.total_dividend_taxes_in_tax_treaties_amount() > 0 }
\summaryrow{Tax treaty reclaim}{\VAR{ gbp(report.total_dividend_taxes_in_tax_treaties_amount()) }}
\BLOCK{ endif }
\BLOCK{ if report.dividend_allowance is not none }
\summaryrow{Dividend allowance}{\VAR{ gbp(report.dividend_allowance) }}
\BLOCK{ endif }
\BLOCK{ if report.dividend_allowance is not none or report.total_dividend_taxes_in_tax_treaties_amount() > 0 }
\summarytotal{Taxable dividend income}{\VAR{ gbp(report.total_dividend_taxable_gain()) }}
\BLOCK{ endif }
\end{summarytable}

\summaryheading{Interest}
\begin{summarytable}
\summaryrow{UK interest income}{\VAR{ gbp(report.total_uk_interest) }}
\summaryrow{Foreign interest income}{\VAR{ gbp(report.total_foreign_interest) }}
\BLOCK{ if report.total_eri_amount(is_interest=True) > 0 }
\summarynote{of which excess reported income}{\VAR{ gbp(report.total_eri_amount(is_interest=True)) }}
\BLOCK{ endif }
\summaryrow{Interest tax paid}{\VAR{ gbp(report.total_interest_tax) }}
\end{summarytable}

\clearpage

\reportsection{Capital gains events}

\BLOCK{ for date_index, symbol_dict in report.calculation_log.items() }

\reportneedspace{10\baselineskip}
\reportdate{\VAR{ date_index.strftime("%d %B %Y") }}
\BLOCK{ for symbol, entries in symbol_dict.items() }
\BLOCK{ set is_disposal = False }
\BLOCK{ set is_acquisition = False }
\BLOCK{ set is_spin_off = False }
\BLOCK{ set is_eri = False }
\BLOCK{ set is_rename = False }
\BLOCK{ set is_transfer_to_spouse = False }
\BLOCK{ set is_gift = False }
\BLOCK{ set is_clogged = False }
\BLOCK{ set is_split = False }
\BLOCK{ set is_exempt = False }
\BLOCK{ if symbol.startswith("sell$") }
    \BLOCK{ set symbol = symbol[5:] }
    \BLOCK{ set is_disposal = True }
\BLOCK{ elif symbol.startswith("buy$") }
    \BLOCK{ set symbol = symbol[4:] }
    \BLOCK{ set is_acquisition = True }
\BLOCK{ elif symbol.startswith("spin-off$") }
    \BLOCK{ set symbol = symbol[9:] }
    \BLOCK{ set is_spin_off = True }
\BLOCK{ elif symbol.startswith("excess-reported-income$") }
    \BLOCK{ set symbol = symbol[23:] }
    \BLOCK{ set is_eri = True }
\BLOCK{ elif symbol.startswith("rename$") }
    \BLOCK{ set symbol = symbol[7:] }
    \BLOCK{ set is_rename = True }
\BLOCK{ elif symbol.startswith("split$") }
    \BLOCK{ set symbol = symbol[6:] }
    \BLOCK{ set is_split = True }
\BLOCK{ elif symbol.startswith("transfer-to-spouse$") }
    \BLOCK{ set symbol = symbol[19:] }
    \BLOCK{ set is_transfer_to_spouse = True }
\BLOCK{ elif symbol.startswith("gift$") }
    \BLOCK{ set symbol = symbol[5:] }
    \BLOCK{ set is_disposal = True }
    \BLOCK{ set is_gift = True }
    \BLOCK{ set is_clogged = True }
\BLOCK{ elif symbol.startswith("gift-unconnected$") }
    \BLOCK{ set symbol = symbol[17:] }
    \BLOCK{ set is_disposal = True }
    \BLOCK{ set is_gift = True }
\BLOCK{ elif symbol.startswith("exempt$") }
    \BLOCK{ set symbol = symbol[7:] }
    \BLOCK{ set is_exempt = True }
\BLOCK{ endif }
\BLOCK{ set overall_quantity = entries|sum(attribute="quantity") }
\BLOCK{ set overall_fees = round_decimal(entries|sum(attribute="fees"), 2) }
\BLOCK{ if is_disposal }
    \BLOCK{ set overall_disposed = round_decimal(entries|sum(attribute="amount") + entries|sum(attribute="fees"), 2) }
    \BLOCK{ set overall_gain = round_decimal(entries|sum(attribute="gain"), 2) }
    \BLOCK{ set disposal_count.value = disposal_count.value + 1 }
    \reportevent{
        Disposal \VAR{ disposal_count.value }: \VAR{ strip_zeros(overall_quantity) }
        \VAR{ "unit" if overall_quantity == 1 else "units" } of \VAR{ symbol }
        \BLOCK{ if is_gift }given away at a market value of\BLOCK{ else }for\BLOCK{ endif }
        \VAR{ gbp(overall_disposed) }
        (\VAR{ gbp(overall_disposed/overall_quantity) } per unit)%
        \BLOCK{ if overall_fees > 0 }
            , with fees of \VAR{ gbp(overall_fees) } treated as allowable cost
        \BLOCK{ endif }
    }
    \BLOCK{ if overall_gain > 0 -}
        Chargeable gain: \textbf{\VAR{ gbp(overall_gain) }}%
        \BLOCK{ if is_gift }, before any relief.

        Gift Hold-over Relief can defer the gain on qualifying shares when both
        parties make the required joint claim on their returns.
        \BLOCK{ else }.
        \BLOCK{ endif }

        \BLOCK{ set total_gain.value = total_gain.value + overall_gain }
        Cumulative gain: \VAR{ gbp(total_gain.value) }
    \BLOCK{ elif overall_gain == 0 }
        Neither a gain nor a loss.
    \BLOCK{ elif is_clogged }
        Clogged loss: \textbf{\VAR{ gbp(-overall_gain) }}, kept separate
        from other capital losses. A loss on a gift to a connected person can
        only be set against gains on disposals to that person while they remain
        connected (TCGA 1992 s18(3)).

        \BLOCK{ set gift_loss.value = gift_loss.value - overall_gain }
        Cumulative losses on gifts: \VAR{ gbp(gift_loss.value) }
    \BLOCK{ else }
        Chargeable loss: \textbf{\VAR{ gbp(-overall_gain) }}

        \BLOCK{ set total_loss.value = total_loss.value - overall_gain }
        Cumulative loss: \VAR{ gbp(total_loss.value) }
    \BLOCK{ endif }
\BLOCK{ elif is_acquisition } % if is_acquisition
    \BLOCK{ set acquisition_cost = round_decimal(entries[0].allowable_cost, 2) }
    \BLOCK{ if overall_quantity > 0 }
        \BLOCK{ set acquisition_count.value = acquisition_count.value + 1 }
        \reportevent{
            Acquisition \VAR{ acquisition_count.value }: \VAR{ strip_zeros(overall_quantity) }
            \VAR{ "unit" if overall_quantity == 1 else "units" } of \VAR{ symbol }
            for \VAR{ gbp(acquisition_cost) }
            (\VAR{ gbp(acquisition_cost/overall_quantity) } per unit)%
            \BLOCK{ if overall_fees > 0 }
                , including fees of \VAR{ gbp(overall_fees) }
            \BLOCK{ endif }
        }
    \BLOCK{ else }
        \reportevent{Management fee for \VAR{ symbol }: \VAR{ gbp(acquisition_cost) }}
    \BLOCK{ endif}
\BLOCK{ elif is_spin_off } % if is_spin_off
    \BLOCK{ set acquisition_cost = round_decimal(entries[0].allowable_cost, 2) }
    \BLOCK{ if overall_quantity > 0 }
        \BLOCK{ set acquisition_count.value = acquisition_count.value + 1 }
        \reportevent{
            Spin-off adjustment \VAR{ acquisition_count.value }:
            \VAR{ entries[0].spin_off.source } pool cost adjusted after
            \VAR{ entries[0].spin_off.dest } shares were spun off
        }
    \BLOCK{ endif }
\BLOCK{ elif is_eri } % if is_eri
    \BLOCK{ set acquisition_cost = round_decimal(entries[0].allowable_cost, 2) }
    \BLOCK{ if overall_quantity > 0 }
        \reportevent{
            Excess reported income: \VAR{ symbol } pool cost increased by \VAR{ gbp(acquisition_cost) }
            (\VAR{ gbp(entries[0].eris[0].price, 4) } per unit)%
        }
    \BLOCK{ endif }
\BLOCK{ elif is_rename } % if is_rename
    \reportevent{
        \VAR{ symbol } was renamed to \VAR{ entries[0].renamed_to }%
        \BLOCK{ if entries[0].quantity > 0 }
            : \VAR{ strip_zeros(entries[0].quantity) }
            \VAR{ "unit" if entries[0].quantity == 1 else "units" } with pool cost
            \VAR{ gbp(entries[0].allowable_cost) } transferred
        \BLOCK{ endif }
    }
\BLOCK{ elif is_split } % if is_split
    \BLOCK{ set split = entries[0].stock_split }
    \reportevent{
        Share reorganisation: \VAR{ strip_zeros(split.day_open_quantity) } units of \VAR{ symbol } restated as \VAR{ strip_zeros(split.scaled_day_open_quantity) } (ratio \VAR{ split.ratio_description })
    }
    Neither a disposal nor an acquisition: the new holding is the same asset, held from the same dates, with the same pooled cost (TCGA 1992 s127).

    Stated as \VAR{ strip_zeros(split.broker_before_quantity) } units before the event and \VAR{ strip_zeros(split.broker_after_quantity) } after.
    \BLOCK{ if split.reconciliation_delta != 0 }

        Reconciled to that count by \VAR{ strip_zeros(split.reconciliation_delta) } units, from \VAR{ strip_zeros(split.quantity_before_reconciliation) } to \VAR{ strip_zeros(split.quantity_after_reconciliation) }.
    \BLOCK{ endif }

    Units in the pool at this point in the day: \VAR{ strip_zeros(entries[0].new_quantity) }%
    \BLOCK{ if entries[0].new_quantity > 0 },
        pool cost \VAR{ gbp(entries[0].new_pool_cost) }
        (\VAR{ gbp(entries[0].new_pool_cost/entries[0].new_quantity) } per unit)%
    \BLOCK{ endif }.
\BLOCK{ elif is_transfer_to_spouse } % if is_transfer_to_spouse
    \reportevent{
        Transfer to spouse: \VAR{ strip_zeros(overall_quantity) }
        \VAR{ "unit" if overall_quantity == 1 else "units" } of \VAR{ symbol }
        (no gain, no loss)
    }
    An allowable cost of \VAR{ gbp(entries|sum(attribute="allowable_cost")) }
    passes to the recipient.

    \BLOCK{ set pool = entries[-1] }
    Closing pool: \VAR{ strip_zeros(pool.new_quantity) }
    \VAR{ "unit" if pool.new_quantity == 1 else "units" }%
    \BLOCK{ if pool.new_quantity > 0 },
        allowable cost \VAR{ gbp(pool.new_pool_cost) }
        (\VAR{ gbp(pool.new_pool_cost/pool.new_quantity) } per unit)%
    \BLOCK{ endif }.
\BLOCK{ elif is_exempt } % if is_exempt
    \BLOCK{ set overall_disposed = round_decimal(entries|sum(attribute="amount") + entries|sum(attribute="fees"), 2) }
    \BLOCK{ set overall_gain = round_decimal(entries|sum(attribute="gain"), 2) }
    \reportevent{
        Exempt disposal: \VAR{ strip_zeros(overall_quantity) }
        \VAR{ "unit" if overall_quantity == 1 else "units" } of \VAR{ symbol }
        valued at \VAR{ gbp(overall_disposed) }
        (\VAR{ gbp(overall_disposed/overall_quantity) } per unit)%
        \BLOCK{ if overall_fees > 0 }
            , \VAR{ gbp(overall_fees) } disposal expenses included in the illustrative calculation
        \BLOCK{ endif }
    }
    The cost and disposal expenses shown below are used for this illustrative calculation only;
    they are not allowable deductions against other gains.

    \BLOCK{ if overall_gain > 0 -}
        Gain is \VAR{ gbp(overall_gain) }; the gain or loss is disregarded (exempt asset).
    \BLOCK{ elif overall_gain == 0 }
        Neither a gain nor a loss; the gain or loss is disregarded (exempt asset).
    \BLOCK{ else }
        Loss is \VAR{ gbp(-overall_gain) }; the gain or loss is disregarded (exempt asset).
    \BLOCK{ endif }
\BLOCK{ endif }

\BLOCK{ if not is_rename and not is_transfer_to_spouse and not is_split }
\begin{reportlist}
\BLOCK{ for entry in entries }
\item \textbf{\VAR{ rule_labels.get(entry.rule_type.name, entry.rule_type.name.replace("_", " ").title()) }}.~Quantity:
\VAR{ strip_zeros(entry.quantity) },
\BLOCK{ if is_disposal }
    \BLOCK{ if entry.quantity < overall_quantity }
        proceeds: \VAR{ gbp(entry.amount + entry.fees) },
    \BLOCK{ endif }
    \BLOCK{ if entry.rule_type.name == "BED_AND_BREAKFAST" }
        allowable cost (matched on \mbox{\VAR{ entry.bed_and_breakfast_date_index.strftime("%d %b %Y") }}):
    \BLOCK{ else }
        allowable cost:
    \BLOCK{ endif }
    \VAR{ gbp(entry.allowable_cost) },
    \BLOCK{ if entry.gain > 0}
        gain: \VAR{ gbp(entry.gain) }.
    \BLOCK{ else }
        loss: \VAR{ gbp(-entry.gain) }.
    \BLOCK{ endif }
\BLOCK{ elif is_exempt }
    \BLOCK{ if entry.quantity < overall_quantity }
        disposal proceeds: \VAR{ gbp(entry.amount + entry.fees) },
    \BLOCK{ endif }
    cost used for this illustrative
    \BLOCK{ if entry.rule_type.name == "BED_AND_BREAKFAST" }
        calculation on \mbox{\VAR{ entry.bed_and_breakfast_date_index.strftime("%d %b %Y") }:}
    \BLOCK{ else }
        calculation:
    \BLOCK{ endif }
    \VAR{ gbp(entry.allowable_cost) },
    \BLOCK{ if entry.gain > 0}
        \mbox{disregarded gain: \VAR{ gbp(entry.gain) }.}
    \BLOCK{ else }
        \mbox{disregarded loss: \VAR{ gbp(-entry.gain) }.}
    \BLOCK{ endif }
\BLOCK{ elif is_spin_off }
    cost before adjustment: \VAR{ gbp(-entry.amount) },
    cost after spin-off: \VAR{ gbp(entry.new_pool_cost) }
\BLOCK{ elif is_eri }
    cost before adjustment: \VAR{ gbp(-entry.amount) },
    cost after adjustment: \VAR{ gbp(entry.new_pool_cost) }%
\BLOCK{ else } % if is_acquisition
    actual cost: \VAR{ gbp(-entry.amount) }.
\BLOCK{ endif}

Closing pool: \VAR{ strip_zeros(entry.new_quantity) }
\VAR{ "unit" if entry.new_quantity == 1 else "units" }%
\BLOCK{ if entry.new_quantity > 0 },
    allowable cost \VAR{ gbp(entry.new_pool_cost) }
    (\VAR{ gbp(entry.new_pool_cost/entry.new_quantity) } per unit)%
    \BLOCK{ if is_acquisition and entry.spin_off}

    Pool cost calculated from the \VAR{entry.spin_off.source} share pool from which
    \VAR{ symbol } shares were spun off%
    \BLOCK{ endif }
    \BLOCK{ if is_acquisition }
        \BLOCK{ for eri in entry.eris }
            \BLOCK{ set eri_cost = round_decimal(eri.price * entry.quantity, 2) }
            \BLOCK{ set eri_date = eri.date.strftime("%d %b %Y") }

    Pool cost increased by \VAR{ gbp(eri_cost) }
    (\VAR{ gbp(eri.price, 4) } per unit)
    due to excess reported income on \mbox{\VAR{ eri_date }}%
        \BLOCK{ endfor }
    \BLOCK{ endif }
\BLOCK{ endif }.

\BLOCK{ endfor}
\end{reportlist}
\BLOCK{ endif }

\BLOCK{ endfor }

\BLOCK{ endfor }

\BLOCK{ if report.calculation_log_yields }
    \reportsection{Dividend and interest events}

    \BLOCK{ for date_index, symbol_dict in report.calculation_log_yields.items() }

    \reportneedspace{7\baselineskip}
    \reportdate{\VAR{ date_index.strftime("%d %B %Y") }}
    \BLOCK{ for symbol, entries in symbol_dict.items() }
    \BLOCK{ set is_dividend = False }
    \BLOCK{ set is_interest = False }
    \BLOCK{ set is_interest_tax = False }
    \BLOCK{ set is_eri_tax = False }
    \BLOCK{ if symbol.startswith("dividend$") }
        \BLOCK{ set symbol = symbol[9:] }
        \BLOCK{ set is_dividend = True }
    \BLOCK{ elif symbol.startswith("interestTax") }
        \BLOCK{ set interest_tax_currency = symbol.split('$')[0][11:] }
        \BLOCK{ set symbol = symbol.split('$', 1)[1] }
        \BLOCK{ set is_interest_tax = True }
        \BLOCK{ if interest_tax_currency == "GBP" }
            \BLOCK{ set interest_tax_str = "UK" }
        \BLOCK{ else }
            \BLOCK{ set interest_tax_str = "Foreign" }
        \BLOCK{ endif }
    \BLOCK{ elif symbol.startswith("interestUK$") }
        \BLOCK{ set symbol = symbol[11:] }
        \BLOCK{ set is_interest = True }
        \BLOCK{ set interest_str = "UK" }
    \BLOCK{ elif symbol.startswith("interest") }
        \BLOCK{ set interest_currency = symbol.split('$', 1)[0][8:] }
        \BLOCK{ set symbol = symbol.split('$', 1)[1] }
        \BLOCK{ set is_interest = True }
        \BLOCK{ set interest_str = "Foreign" }
    \BLOCK{ elif symbol.startswith("excess-reported-income-distribution$") }
        \BLOCK{ set symbol = symbol[36:] }
        \BLOCK{ set is_eri_tax = True }
    \BLOCK{ endif }
    \BLOCK{ if is_dividend }
        \BLOCK{ set type_str = "" }
        \BLOCK{ set dividend_count.value = dividend_count.value + 1 }
        \BLOCK{ if entries[0].dividend.is_interest }
            \BLOCK{ set type_str = " (interest)" }
        \BLOCK{ endif }
        \textbf{Dividend \VAR{ dividend_count.value }:} \VAR{ symbol + type_str },
        \VAR{ gbp(entries[0].amount) }%
        \BLOCK{ if not entries[0].dividend.is_interest }
            ; tax paid at source \VAR{ gbp(-entries[0].dividend.tax_at_source) }%
        \BLOCK{ endif }
        \BLOCK{ if entries[0].dividend.tax_treaty }
            ; tax treaty reclaim \VAR{ gbp(entries[0].dividend.tax_treaty_amount) }
            (\VAR{ entries[0].dividend.tax_treaty.country } treaty rate:
            \VAR{ round_decimal(100 * entries[0].dividend.tax_treaty.treaty_rate, 2) }\%)%
        \BLOCK{ endif }.\par
    \BLOCK{ elif is_interest } % if is_interest
        \BLOCK{ set interest_count.value = interest_count.value + 1 }
        \textbf{\VAR{ interest_str } interest \VAR{ interest_count.value }:}
        \VAR{ symbol }\BLOCK{ if interest_str == "Foreign" } (\VAR{ interest_currency })\BLOCK{ endif },
        \VAR{ gbp(entries[0].amount) }.\par
    \BLOCK{ elif is_interest_tax } % if is_interest_tax
        \BLOCK{ set interest_tax_count.value = interest_tax_count.value + 1 }
        \textbf{\VAR{ interest_tax_str } interest tax \VAR{ interest_tax_count.value }:}
        \VAR{ symbol }\BLOCK{ if interest_tax_str == "Foreign" } (\VAR{ interest_tax_currency })\BLOCK{ endif },
        \VAR{ gbp(entries[0].amount) }.\par
    \BLOCK{ elif is_eri_tax } % if is_eri_tax
        \BLOCK{ if entries[0].eris[0].is_interest }
            \BLOCK{ set type_str = " (interest)" }
        \BLOCK{ else }
            \BLOCK{ set type_str = " (dividend)" }
        \BLOCK{ endif }
        \BLOCK{ set eri_income = round_decimal(entries[0].amount, 2) }
        \BLOCK{ set eri_count.value = eri_count.value + 1 }
        \textbf{Excess reported income distribution \VAR{ eri_count.value }:}
        \VAR{ symbol + type_str }, \VAR{ gbp(eri_income) }
        (\VAR{ gbp(entries[0].eris[0].price, 4) } per unit).\par
    \BLOCK{ endif }

    \BLOCK{ endfor }

    \BLOCK{ endfor }
\BLOCK{ endif }
\end{document}
